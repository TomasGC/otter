# ============================================
# Keystore
# ============================================
# Keep debug keystore for consistent signing
# keystore/*.keystore is intentionally tracked for debug builds
keystore/release.keystore

# ============================================
# Claude Code
# ============================================
# Local/temporary files (not committed)
**/*.local.*
**/.local/
.claude/tmpclaude/
.claude/sessions/

# ============================================
# Test artifacts
# ============================================
ignored_tests/
*test-results*.txt
*test-results*.log
test-run-final.txt

# ============================================
# Temporary files (logs, cache, etc.)
# ============================================
# All temporary files go in temp/ directory
temp/
*archives/

# ============================================
# Python
# ============================================
scripts/__pycache__/
__pycache__/
*.pyc
*.pyo

# Test coverage reports
scripts/.pytest_cache/
scripts/htmlcov/
scripts/coverage.xml
scripts/coverage.json
scripts/.coverage
.coverage

# ============================================
# Tools
# ============================================
ktlint
