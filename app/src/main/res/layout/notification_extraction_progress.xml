<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Title -->
    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Extracting archive.zip"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FF000000"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Progress bar with percentage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ProgressBar
            android:id="@+id/notification_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/notification_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="12sp"
            android:textColor="#FF666666"
            android:layout_marginStart="8dp"
            android:minWidth="32dp"
            android:gravity="end" />

    </LinearLayout>

    <!-- File list (last 3 files) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/notification_file_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ file1.txt"
            android:textSize="12sp"
            android:textColor="#FF666666"
            android:ellipsize="middle"
            android:maxLines="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notification_file_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ file2.jpg"
            android:textSize="12sp"
            android:textColor="#FF666666"
            android:ellipsize="middle"
            android:maxLines="1"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notification_file_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="→ file3.pdf"
            android:textSize="12sp"
            android:textColor="#FF000000"
            android:ellipsize="middle"
            android:maxLines="1"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Counter and action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notification_counter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0/0 files"
            android:textSize="12sp"
            android:textColor="#FF666666" />

        <!-- Buttons will be added programmatically via NotificationCompat actions -->

    </LinearLayout>

</LinearLayout>
